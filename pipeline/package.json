{
  "name": "@tarkov-companion/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Normalizes json.tarkov.dev data into versioned bundles for the Tarkov Companion app",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch": "tsx src/cli/fetch.ts",
    "fixtures": "tsx src/scripts/capture-fixtures.ts",
    "normalize": "tsx src/cli/normalize.ts",
    "bundle": "tsx src/cli/bundle.ts",
    "validate:fixtures": "tsx src/cli/validate-fixtures.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}

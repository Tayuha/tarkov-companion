root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
indent_size = 2
max_line_length = 80

[*.{json,jsonc,yml,yaml,ts,js,mjs,cjs}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for a hard line break in a few documents.
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,gif,ico,webp,AppImage,deb}]
insert_final_newline = false

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
